# Optional. The app works fully in template mode with no API credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Live Firebase setup is described in docs/firebase-setup.md.
# Local demo uses an in-memory request budget and requires no Firebase account.
SKYCLAIM_DEPLOYMENT_MODE=demo
SKYCLAIM_RATE_LIMIT_BACKEND=memory
SKYCLAIM_ENABLE_AI=false
# Exact public HTTPS origin for live mode. No trailing slash.
APP_ORIGIN=
## Keep previews out of search. Enable only after the public-launch review.
SKYCLAIM_ALLOW_INDEXING=false
# Public operator details; name/country must be confirmed before public launch.
SKYCLAIM_OPERATOR_NAME=
SKYCLAIM_OPERATOR_COUNTRY=
SKYCLAIM_SUPPORT_EMAIL=kunalshinde1805@gmail.com
# Emergency assessment switch. False returns a retryable 503 before processing.
SKYCLAIM_CHECKS_ENABLED=true
