# Optional. The app works fully in template mode with no API credentials.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Live Firebase setup is described in docs/firebase-setup.md.
# Local demo uses an in-memory request budget and requires no Firebase account.
SKYCLAIM_DEPLOYMENT_MODE=demo
SKYCLAIM_RATE_LIMIT_BACKEND=memory
SKYCLAIM_ENABLE_AI=false
# Exact public HTTPS origin for live mode. No trailing slash.
APP_ORIGIN=
